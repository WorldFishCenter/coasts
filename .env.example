# Mapbox access token (required for map display).
# Get a token at https://account.mapbox.com/
# Do not commit .env; it is gitignored.
VITE_MAPBOX_TOKEN=

# Google Analytics 4 measurement ID (optional).
# Analytics only loads in production builds; set VITE_GA_DEBUG=true to test locally.
VITE_GA_MEASUREMENT_ID=
VITE_GA_DEBUG=

# PostHog product analytics, session replay and error tracking (optional).
# The project the WIO country dashboards share. Set on the Vercel Production
# environment only; unset turns PostHog off.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
