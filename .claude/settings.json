{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run preview*)",
      "Bash(npm run qa:clarity*)",
      "Bash(npx eslint:*)",
      "Bash(grep:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  }
}
